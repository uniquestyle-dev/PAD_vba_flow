        WebAutomation.ExecuteJavascript BrowserInstance: Browser Javascript: $'''function ExecuteScript() {
    var rows = document.querySelectorAll(\'table.c-table tbody > tr\');
    var data = [];
    for (var i = 0; i < rows.length; i++) {
        var cells = rows[i].querySelectorAll(\'td\');
        if (!cells[0] || !cells[0].id || cells[0].id.indexOf(\'od_td_\') !== 0) continue;

        var payCell = cells[5];
        var payClone = payCell.cloneNode(true);
        var removes = payClone.querySelectorAll(\'.result-box, div[style], span[class]\');
        for (var r = 0; r < removes.length; r++) removes[r].remove();
        var payment = payClone.textContent.replace(/\\s+/g, \' \').trim();

        var custCell = cells[3];
        var ul = custCell.querySelector(\'ul[link-param]\');
        var email = \'\', custId = \'\';
        if (ul) {
            try {
                var p = JSON.parse(ul.getAttribute(\'link-param\'));
                email = p.email || \'\';
                custId = p.customer_id || \'\';
            } catch(e) {}
        }

        var custName = \'\';
        var firstDiv = custCell.querySelector(\'div\');
        if (firstDiv && firstDiv.childNodes.length > 0) {
            var txt = firstDiv.childNodes[0].textContent.trim();
            custName = txt.replace(/\\[.*$/, \'\').trim();
        }

        var orderA = cells[2].querySelector(\'.mt05 a\');
        var orderId = orderA ? orderA.textContent.trim() : \'\';

        data.push({
            orderId: orderId,
            customerId: custId,
            custName: custName,
            email: email,
            payment: payment
        });
    }
    return JSON.stringify(data);
}''' Result=> TableJson
