/# ########　サラシア変換サプリマクロ実行　########
#/
Scripting.RunVBScript.RunVBScript VBScriptCode: $'''Option Explicit

Dim xlApp, xlWb, errMsg

On Error Resume Next

\' ── Excel起動 ──
Set xlApp = CreateObject(\"Excel.Application\")
If Err.Number <> 0 Then
    WScript.Echo \"Excelの起動に失敗しました: \" & Err.Description
    WScript.Quit 1
End If
Err.Clear

xlApp.Visible = True
xlApp.DisplayAlerts = False

\' ── PERSONAL.XLSB を開く（既に開いている場合はスキップ） ──
Dim personalPath
personalPath = xlApp.Application.StartupPath & \"\\PERSONAL.XLSB\"

Dim alreadyOpen: alreadyOpen = False
Dim wb
For Each wb In xlApp.Workbooks
    If UCase(wb.Name) = \"PERSONAL.XLSB\" Then
        alreadyOpen = True
        Exit For
    End If
Next
If Not alreadyOpen Then
    xlApp.Workbooks.Open personalPath
    If Err.Number <> 0 Then
        WScript.Echo \"PERSONAL.XLSBを開けませんでした: \" & Err.Description
        xlApp.Quit
        WScript.Quit 1
    End If
    Err.Clear
End If

\' ── マクロ実行 ──
xlApp.Run \"PERSONAL.XLSB!サラシア変換サプリ\"
If Err.Number <> 0 Then
    errMsg = Err.Description
    WScript.Echo \"マクロ実行エラー: \" & errMsg
    xlApp.DisplayAlerts = True
    WScript.Quit 1
End If

\' ── マクロが生成/操作したブックを保存せず閉じる ──
xlApp.DisplayAlerts = False          \' ← Falseのまま維持

Dim w
For Each w In xlApp.Workbooks
    If UCase(w.Name) <> \"PERSONAL.XLSB\" Then
        w.Close False
    End If
Next

xlApp.Quit
Set xlApp = Nothing
WScript.Quit 0''' ScriptOutput=> VBScriptOutput
