            WebAutomation.PressButton.PressButton BrowserInstance: Browser Control: appmask['Web Page \'https://clickpost.jp/mypage/index\'']['Button \'クリックポスト一括登録決済印刷 v4.3.4\''] WaitForPageToLoadTimeout: 60
            WAIT 2
            WebAutomation.ExecuteJavascript BrowserInstance: Browser Javascript: $'''function ExecuteScript() {
    var cells = document.querySelectorAll(\'div[data-field=\"status\"]\');
    for (var i = 0; i < cells.length; i++) {
        if (cells[i].textContent.trim() === \'未処理\') {
            var rect = cells[i].getBoundingClientRect();
            var x = Math.round(window.screenX + (window.outerWidth - window.innerWidth) / 2 + rect.left + rect.width / 2);
            var y = Math.round(window.screenY + (window.outerHeight - window.innerHeight) + rect.top + rect.height / 2);
            return x + \',\' + y;
        }
    }
    return \'not found\';
}''' Result=> Result
        END
    END
END
